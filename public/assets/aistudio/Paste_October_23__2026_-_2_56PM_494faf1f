      transform: translateX(14px);
      font-style: italic;
      color: #14161A;
    }
    .treatment-item .treatment-cta {
      opacity: 0;
      transform: translateX(-10px);
      transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .treatment-item.active .treatment-cta,
    .treatment-item:hover .treatment-cta {
      opacity: 1;
      transform: translateX(0);
    }

    .faq-content {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.35s ease;
      opacity: 0;
    }
    .faq-row.open .faq-content {
      grid-template-rows: 1fr;
      opacity: 1;
    }
    .faq-row.open .faq-btn {
      background-color: #14161A;
      color: #F3EFE6;
      border-color: #14161A;
