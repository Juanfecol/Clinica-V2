  <!-- =====================================================
       MOTOR DE SECUENCIA DE FRAMES .WEBP + SCROLL ANIMATIONS
       ===================================================== -->
  <script>
    // Si descargas la carpeta /frames a tu servidor local, cambia BASE_URL a ""
    const BASE_URL = "https://dentaria.cloudflagency.com";
    const TOTAL_FRAMES = 90; // Número de frames de la secuencia en /frames/desktop/
    const loadedFrames = [];
    let validMaxFrame = 1;

    const heroSequenceImg = document.getElementById('hero-sequence-img');
    const heroSourceMobile = document.getElementById('hero-source-mobile');

    // Precarga progresiva de los fotogramas .webp originales
    const isPortraitMobile = window.matchMedia("(max-width: 1023px) and (orientation: portrait)").matches;
    const folder = isPortraitMobile ? "mobile" : "desktop";

    for (let i = 1; i <= TOTAL_FRAMES; i++) {
      const num = String(i).padStart(4, '0');
      const img = new Image();
      const url = `${BASE_URL}/frames/${folder}/frame_${num}.webp`;
      img.src = url;
      img.onload = () => {
        loadedFrames[i] = url;
        if (i > validMaxFrame) validMaxFrame = i;
      };
    }

    // 1. Preparar palabras del Manifesto
    const manifestoEl = document.getElementById('manifesto-scrub');
    const rawWords = manifestoEl.innerText.trim().split(/\s+/);
    manifestoEl.innerHTML = rawWords
      .map(w => `<span class="m-word transition-colors duration-150" style="opacity:0.22">${w} </span>`)
      .join('');
    const manifestoSpans = document.querySelectorAll('.m-word');

    // Referencias DOM
    const header = document.getElementById('site-header');
    const headerCta = document.getElementById('header-cta');
    const heroSection = document.getElementById('top');
    const beat1 = document.getElementById('hero-beat-1');
    const beat2 = document.getElementById('hero-beat-2');
    const beat3 = document.getElementById('hero-beat-3');
    const heroStepNum = document.getElementById('hero-step-num');
    const heroScrollLabel = document.getElementById('hero-scroll-label');

    const consultaSection = document.getElementById('primeira-consulta');
    const consultaLine = document.getElementById('consulta-progress-line');
    const stepDot2 = document.getElementById('step-dot-2');
    const stepDot3 = document.getElementById('step-dot-3');

    const clinicaSection = document.getElementById('clinica');
    const clinicaTrack = document.getElementById('clinica-horizontal-track');
    const clinicaInnerImgs = document.querySelectorAll('.clinica-inner-img');

    const marcacaoSection = document.getElementById('marcacao');
    const parallaxImgs = document.querySelectorAll('[data-parallax]');

    const clamp = (val, min, max) => Math.min(Math.max(val, min), max);

    function onScrollUpdate() {
      const vh = window.innerHeight;

      // A. HERO SCROLLYTELLING + FRAME SCRUBBING
      const heroRect = heroSection.getBoundingClientRect();
      const heroTotal = heroSection.offsetHeight - vh;
      const heroP = clamp(-heroRect.top / heroTotal, 0, 1);

      // Si los frames .webp están cargados, actualiza el fotograma exacto; además aplica zoom suave de respaldo
      if (validMaxFrame > 1) {
        const frameIdx = clamp(Math.floor(1 + heroP * (validMaxFrame - 1)), 1, validMaxFrame);
        if (loadedFrames[frameIdx]) {
          heroSequenceImg.src = loadedFrames[frameIdx];
          if (heroSourceMobile) heroSourceMobile.srcset = loadedFrames[frameIdx];
        }
      } else {
        const camScale = 1 + heroP * 0.34;
        const camX = -heroP * 4.5;
        const camY = heroP * 2.5;
        heroSequenceImg.style.transform = `scale3d(${camScale}, ${camScale}, 1) translate3d(${camX}%, ${camY}%, 0)`;
      }

      if (heroP < 0.33) {
        const localP = heroP / 0.33;
        heroStepNum.textContent = '01';
        heroScrollLabel.style.opacity = String(clamp(1 - localP * 1.8, 0, 1));

        beat1.style.opacity = String(clamp(1 - Math.max(0, localP - 0.65) * 3, 0, 1));
        beat1.style.transform = `translate3d(0, ${-localP * 28}px, 0)`;
        beat1.style.pointerEvents = 'auto';

        beat2.style.opacity = '0';
        beat2.style.pointerEvents = 'none';
        beat3.style.opacity = '0';
        beat3.style.pointerEvents = 'none';
      } else if (heroP < 0.68) {
        const localP = (heroP - 0.33) / 0.35;
        heroStepNum.textContent = '02';
        heroScrollLabel.style.opacity = '0';

        beat1.style.opacity = '0';
        beat1.style.pointerEvents = 'none';

        const fadeIn = clamp(localP * 3.2, 0, 1);
        const fadeOut = clamp(1 - Math.max(0, localP - 0.68) * 3.2, 0, 1);
        beat2.style.opacity = String(Math.min(fadeIn, fadeOut));
        beat2.style.transform = `translate3d(0, ${(1 - fadeIn) * 26 - (1 - fadeOut) * 26}px, 0)`;
        beat2.style.pointerEvents = 'auto';

        beat3.style.opacity = '0';
        beat3.style.pointerEvents = 'none';
      } else {
        const localP = (heroP - 0.68) / 0.32;
        heroStepNum.textContent = '03';
        heroScrollLabel.style.opacity = '0';

        beat1.style.opacity = '0';
        beat2.style.opacity = '0';
        beat2.style.pointerEvents = 'none';

        const fadeIn = clamp(localP * 3, 0, 1);
        beat3.style.opacity = String(fadeIn);
        beat3.style.transform = `translate3d(0, ${(1 - fadeIn) * 26}px, 0)`;
        beat3.style.pointerEvents = 'auto';
      }

      // B. NAVBAR ADAPTATIVA
      const marcacaoRect = marcacaoSection.getBoundingClientRect();
      const inHero = heroRect.bottom > 72;
      const inMarcacao = marcacaoRect.top <= 72 && marcacaoRect.bottom >= 72;

      if (inHero) {
        header.className = 'fixed inset-x-0 top-0 z-50 transition-all duration-500 py-5 text-paper bg-transparent';
        headerCta.className = 'px-6 py-2.5 rounded-full text-[12.5px] font-medium bg-paper text-ink hover:scale-105 transition-all duration-300';
      } else if (inMarcacao) {
        header.className = 'fixed inset-x-0 top-0 z-50 transition-all duration-500 py-4 text-paper bg-ink/85 backdrop-blur-md border-b border-paper/10';
        headerCta.className = 'px-6 py-2.5 rounded-full text-[12.5px] font-medium bg-paper text-ink hover:scale-105 transition-all duration-300';
      } else {
        header.className = 'fixed inset-x-0 top-0 z-50 transition-all duration-500 py-4 text-ink bg-paper/85 backdrop-blur-md border-b border-ink/10';
        headerCta.className = 'px-6 py-2.5 rounded-full text-[12.5px] font-medium bg-ink text-paper hover:scale-105 transition-all duration-300';
      }

      // C. MANIFESTO PALABRA POR PALABRA
      const mRect = manifestoEl.getBoundingClientRect();
      const mStart = vh * 0.84;
      const mEnd = vh * 0.24;
      const mProg = clamp((mStart - mRect.top) / (mStart - mEnd), 0, 1);
      const litWords = mProg * manifestoSpans.length;

      manifestoSpans.forEach((span, idx) => {
        const wordProg = clamp(litWords - idx, 0, 1);
        span.style.opacity = String(0.22 + wordProg * 0.78);
      });

      // D. LÍNEA HORIZONTAL EN "A PRIMEIRA CONSULTA"
      const cRect = consultaSection.getBoundingClientRect();
      const cProg = clamp((vh * 0.75 - cRect.top) / (cRect.height * 0.75), 0, 1);
      consultaLine.style.width = `${12 + cProg * 88}%`;

      if (cProg > 0.36) {
        stepDot2.classList.add('bg-ink', 'border-ink');
        stepDot2.classList.remove('bg-stone', 'border-ink/40');
      } else {
        stepDot2.classList.remove('bg-ink', 'border-ink');
        stepDot2.classList.add('bg-stone', 'border-ink/40');
      }

      if (cProg > 0.72) {
        stepDot3.classList.add('bg-ink', 'border-ink');
        stepDot3.classList.remove('bg-stone', 'border-ink/40');
      } else {
        stepDot3.classList.remove('bg-ink', 'border-ink');
        stepDot3.classList.add('bg-stone', 'border-ink/40');
      }

      // E. A CLÍNICA: STICKY HORIZONTAL SCROLL + VENTANA PARALLAX INTERNA
      const clRect = clinicaSection.getBoundingClientRect();
      const clScrollable = clinicaSection.offsetHeight - vh;
      const clProg = clamp(-clRect.top / clScrollable, 0, 1);

      const maxTranslateX = Math.max(0, clinicaTrack.scrollWidth - window.innerWidth);
      const currentX = -clProg * maxTranslateX;
      clinicaTrack.style.transform = `translate3d(${currentX}px, 0, 0)`;

      clinicaInnerImgs.forEach((img) => {
        const shiftPercent = clProg * 22;
        img.style.transform = `translate3d(${shiftPercent}%, 0, 0)`;
      });

      // F. PARALLAX VERTICAL EN FOTOS GRANDES Y EQUIPO
      parallaxImgs.forEach((img) => {
        const parent = img.parentElement;
        const rect = parent.getBoundingClientRect();
        if (rect.bottom > 0 && rect.top < vh) {
          const speed = parseFloat(img.getAttribute('data-parallax') || '0.18');
          const relY = (vh * 0.5 - (rect.top + rect.height * 0.5)) * speed;
          img.style.transform = `translate3d(0, ${relY}px, 0)`;
        }
      });
    }

    window.addEventListener('scroll', () => requestAnimationFrame(onScrollUpdate), { passive: true });
    window.addEventListener('resize', () => requestAnimationFrame(onScrollUpdate));
    onScrollUpdate();

    // Interacción en Tratamentos
    const treatmentItems = document.querySelectorAll('.treatment-item');
    const treatmentImg = document.getElementById('treatment-img');
    const treatmentCaption = document.getElementById('treatment-caption');
    const selectTratamento = document.getElementById('input-tratamento');

    treatmentItems.forEach((item) => {
      item.addEventListener('mouseenter', () => {
        treatmentItems.forEach(i => i.classList.remove('active'));
        item.classList.add('active');

        const newSrc = item.getAttribute('data-img');
        const newCap = item.getAttribute('data-caption');

        if (treatmentImg.src !== newSrc) {
          treatmentImg.style.opacity = '0.3';
          treatmentImg.style.transform = 'scale(1.06)';
          setTimeout(() => {
            treatmentImg.src = newSrc;
            treatmentCaption.textContent = newCap;
            treatmentImg.style.opacity = '1';
            treatmentImg.style.transform = 'scale(1)';
          }, 150);
        }
      });

      item.addEventListener('click', () => {
        const chosen = item.getAttribute('data-treatment');
        if (chosen && selectTratamento) selectTratamento.value = chosen;
        document.getElementById('marcacao').scrollIntoView({ behavior: 'smooth' });
      });
    });

    // Carrusel de Avaliações (01/04 a 04/04)
    const reviewsData = [
      {
        text: '“SUBSTITUIR POR AVALIAÇÃO REAL. Exemplo do tamanho de uma avaliação no Google, para testar o carrossel.”',
        author: '[Nome do paciente]'
      },
      {
        text: '“SUBSTITUIR POR AVALIAÇÃO REAL. Segunda avaliação de exemplo, idealmente sobre a primeira consulta ou o atendimento.”',
        author: '[Nome do paciente]'
      },
      {
        text: '“SUBSTITUIR POR AVALIAÇÃO REAL. Copiar o texto tal como está publicado e o nome como aparece no Google.”',
        author: '[Nome do paciente]'
      },
      {
        text: '“SUBSTITUIR POR AVALIAÇÃO REAL. Quarta avaliação de exemplo.”',
        author: '[Nome do paciente]'
      }
    ];

    let revIdx = 0;
    const reviewBox = document.getElementById('review-box');
    const reviewText = document.getElementById('review-text');
    const reviewAuthor = document.getElementById('review-author');
    const reviewCounter = document.getElementById('review-counter');

    function renderReview(idx) {
      reviewBox.style.opacity = '0';
      reviewBox.style.transform = 'translateY(8px)';
      setTimeout(() => {
        reviewText.textContent = reviewsData[idx].text;
        reviewAuthor.textContent = reviewsData[idx].author;
        reviewCounter.textContent = `0${idx + 1}`;
        reviewBox.style.opacity = '1';
        reviewBox.style.transform = 'translateY(0)';
      }, 180);
    }

    document.getElementById('review-next').addEventListener('click', () => {
      revIdx = (revIdx + 1) % reviewsData.length;
      renderReview(revIdx);
    });

    document.getElementById('review-prev').addEventListener('click', () => {
      revIdx = (revIdx - 1 + reviewsData.length) % reviewsData.length;
      renderReview(revIdx);
    });

    // Mostrar Mapa en Marcação
    document.getElementById('show-map-btn').addEventListener('click', () => {
      document.getElementById('map-card-preview').classList.add('hidden');
      document.getElementById('map-embed').classList.remove('hidden');
    });

    // Acordeón de Perguntas Frequentes
    const faqRows = document.querySelectorAll('.faq-row');
    faqRows.forEach((row) => {
      row.addEventListener('click', () => {
        const isOpen = row.classList.contains('open');
        faqRows.forEach(r => r.classList.remove('open'));
        if (!isOpen) row.classList.add('open');
      });
    });

    // Envío del Formulario por WhatsApp
    document.getElementById('booking-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const nome = document.getElementById('input-nome').value;
      const tel = document.getElementById('input-telefone').value;
      const trat = document.getElementById('input-tratamento').value;
      const dia = document.getElementById('input-dia').value;
      const hora = document.getElementById('input-hora').value;

      const text = `Olá! Gostaria de marcar uma consulta.\n\n*Nome:* ${nome}\n*Telefone:* ${tel}\n*Tratamento:* ${trat}\n*Preferência de dia:* ${dia}\n*Preferência de hora:* ${hora}`;
      window.open(`https://wa.me/351000000000?text=${encodeURIComponent(text)}`, '_blank');
    });
  </script>
</body>
